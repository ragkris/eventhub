{
  "info": {
    "name": "EventHub API",
    "_postman_id": "4b0cfc8a-7e2e-4e36-90f8-eventhub0001",
    "description": "EventHub API test requests. Run Create Event first, then Successful Reservation, Overbooking Failure, and Cancel Reservation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "event_id",
      "value": "1"
    },
    {
      "key": "reservation_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"PyCon India\",\n  \"venue\": \"NIMHANS Convention Centre, Bangalore\",\n  \"date\": \"2027-09-20\",\n  \"total_seats\": 3,\n  \"available_seats\": 3,\n  \"status\": \"upcoming\"\n}"
            },
            "url": "{{base_url}}/api/events/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('event_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/"
          }
        },
        {
          "name": "Filter Events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/?status=upcoming&venue=bangalore"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Successful Reservation (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"{{event_id}}\",\n  \"attendee_name\": \"Priya Sharma\",\n  \"attendee_email\": \"priya@example.com\",\n  \"seats_reserved\": 2\n}"
            },
            "url": "{{base_url}}/api/reservations/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('reservation_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Overbooking Failure (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"{{event_id}}\",\n  \"attendee_name\": \"Alex Example\",\n  \"attendee_email\": \"alex@example.com\",\n  \"seats_reserved\": 99\n}"
            },
            "url": "{{base_url}}/api/reservations/"
          }
        },
        {
          "name": "List Reservations",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reservations/"
          }
        },
        {
          "name": "Filter Reservations by Event",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reservations/?event_id={{event_id}}"
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/reservations/{{reservation_id}}/cancel/"
          }
        }
      ]
    }
  ]
}